
{
  "name": "weizai",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "SUPPORT_PER_IP",
      "namespace_id": "9431001",
      "simple": {
        "limit": 6,
        "period": 60
      }
    },
    {
      "name": "SUPPORT_GLOBAL",
      "namespace_id": "9431002",
      "simple": {
        "limit": 80,
        "period": 60
      }
    }
  ]
}
