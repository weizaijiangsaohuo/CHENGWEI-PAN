{
  "name": "weizai",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "SUPPORT_PER_IP",
      "namespace_id": "9431001",
      "simple": {
        "limit": 6,
        "period": 60
      }
    },
    {
      "name": "SUPPORT_GLOBAL",
      "namespace_id": "9431002",
      "simple": {
        "limit": 80,
        "period": 60
      }
    }
  ],
  "previews": {
    "ai": {
      "binding": "AI"
    },
    "vars": {
      "STARFLOW_AUTH_ORIGIN": "https://feature-neon-backend-foundation-20261120-weizai.weizai.workers.dev",
      "STARFLOW_PREVIEW_DB_HOST": "ep-plain-snow-b3x6hb9a.c-4.ap-southeast-1.aws.neon.tech",
      "STARFLOW_V2_ENABLED": "false",
      "STARFLOW_V2_PREVIEW_ONLY": "true"
    }
  }
}
