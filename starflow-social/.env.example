# 在 Supabase -> Project Settings -> API 中查看；只需要 public anon key，不能使用 service_role。
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# 在 Cloudflare Turnstile 中创建站点，填写公开 site key。
# 请在 Supabase -> Authentication -> Bot and Abuse Protection 中开启 Turnstile 并填写 SECRET。
# 真实 Secret 绝不能放在 NEXT_PUBLIC_ 开头的变量中。
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# 配好 Supabase 中的 Google OAuth provider 后改成 true。
NEXT_PUBLIC_GOOGLE_ENABLED=false


# 以下为 Supabase Edge Function Secrets，仅在 Supabase 控制台配置，绝不能放在前端 .env.local。
# RESEND_API_KEY=你的 Resend 私密 API Key
# WELCOME_FROM_EMAIL=星流 <welcome@你验证过的域名>
# WELCOME_SITE_NAME=星流 Starflow
# WELCOME_SITE_URL=https://你实际部署的网站地址
