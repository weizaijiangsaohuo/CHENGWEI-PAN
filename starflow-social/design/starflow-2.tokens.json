    "sm": {
      "$type": "dimension",
      "$value": "12px"
    },
    "md": {
      "$type": "dimension",
      "$value": "16px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "20px"
    },
    "glass": {
      "$type": "dimension",
      "$value": "24px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "typography": {
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Inter",
        "-apple-system",
        "BlinkMacSystemFont",
        "PingFang SC",
        "Noto Sans SC",
        "sans-serif"
      ]
    },
    "size": {
      "caption": {
        "$type": "dimension",
        "$value": "12px"
      },
      "secondary": {
        "$type": "dimension",
        "$value": "13px"
      },
      "body": {
        "$type": "dimension",
        "$value": "15px"
      },
      "subtitle": {
        "$type": "dimension",
        "$value": "18px"
      },
      "title": {
        "$type": "dimension",
        "$value": "22px"
      },
      "display": {
        "$type": "dimension",
        "$value": "28px"
      }
    }
  },
  "motion": {
    "fast": {
      "$type": "duration",
      "$value": "140ms"
    },
    "normal": {
      "$type": "duration",
      "$value": "220ms"
    },
    "navigation": {
      "$type": "duration",
      "$value": "320ms"
    },
    "curve": {
      "$type": "cubicBezier",
      "$value": [
        0.2,
        0.8,
        0.2,
        1
      ]
    }
  },
  "glass": {
    "navigation": {
      "blurPx": 18,
      "saturationPercent": 132,
      "alpha": 0.84
    },
    "overlay": {
      "blurPx": 22,
      "saturationPercent": 145,
      "alpha": 0.92
    },
    "highlight": {
      "opacity": 0.7,
      "strokeWidthPx": 1
    },
    "maxLargeBlurLayers": 2
  }
}
