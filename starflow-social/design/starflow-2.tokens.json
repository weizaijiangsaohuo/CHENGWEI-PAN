    },
    "24": {
      "$type": "dimension",
      "$value": "24px"
    },
    "32": {
      "$type": "dimension",
      "$value": "32px"
    },
    "40": {
      "$type": "dimension",
      "$value": "40px"
    },
    "48": {
      "$type": "dimension",
      "$value": "48px"
