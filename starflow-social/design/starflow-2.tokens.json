      },
      "text": {
        "$type": "color",
        "$value": "#1D1B24"
      },
      "muted": {
        "$type": "color",
        "$value": "#696674"
      },
      "border": {
        "$type": "color",
        "$value": "#EAE8F0"
      },
      "glass": {
